DATABASE_URL="postgresql://squadup:squadup@localhost:5432/squadup?schema=public"

# Public origin used for share links + Open Graph URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js / NextAuth  (generate with: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Development ONLY: enables a "dev login" provider so member features can be tried
# without Google credentials. Ignored when NODE_ENV=production.
DEV_LOGIN="false"
