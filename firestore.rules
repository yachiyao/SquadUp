rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: rooms
// Document ID: {roomId} (e.g., SQ-XXXX)
// Fields:
//   - id: string (required, immutable, matches roomId, 1..64 chars) - Unique gathering room code
//   - title: string (required, 1..200 chars) - Gathering event title
//   - hostNickname: string (required, 1..100 chars) - Host display nickname
//   - maxParticipants: number (required, 1..20) - Maximum participant capacity including host
//   - expiryDays: number (optional, 1..365) - Link validity period in days
//   - passcode: string (optional, 0..32 chars) - Optional room entry passcode
//   - passcodeUnlocked: bool (optional) - Client unlock state flag
//   - storageMode: string (optional, 1..32 chars) - Storage sync mode ('cloud' or 'local')
//   - hostUid: string (optional, 0..128 chars) - Optional Firebase Auth UID of host if signed in
//   - hostEmail: string (optional, 0..254 chars) - Optional email of host if signed in
//   - createdAt: string (optional, immutable once set, 0..64 chars) - ISO creation timestamp
//   - updatedAt: string or number (optional) - Last modification timestamp (ISO string or epoch ms)
//   - actorUpdatedAt: map (optional, max 100 keys) - Per-participant CRDT update timestamps
//   - kickedIds: map (optional, max 100 keys) - Map of kicked participant IDs to kick timestamps
//   - isFinalized: bool (optional) - Whether the gathering time/location has been finalized
//   - finalDate: string or null (optional, 0..32 chars) - Confirmed date (YYYY-MM-DD)
//   - finalSlot: string or null (optional, 0..32 chars) - Confirmed time slot ID
//   - finalLocation: string or null (optional, 0..200 chars) - Confirmed location name
//   - locations: list (required, max 10 items) - Candidate locations list
//   - participants: list (required, max 50 items) - Joined participants list
//   - votes: list (required, max 2000 items) - Availability time-slot votes list
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string (if present and non-null, must be string and within length)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate that a list is a list and enforces size limits
    function isValidList(listData, maxSize) {
      return listData is list && listData.size() <= maxSize;
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidRoom(data, roomId) {
      let allowedFields = [
        'id',
        'title',
        'hostNickname',
        'maxParticipants',
        'expiryDays',
        'passcode',
        'passcodeUnlocked',
        'storageMode',
        'hostUid',
        'hostEmail',
        'createdAt',
        'updatedAt',
        'actorUpdatedAt',
        'kickedIds',
        'isFinalized',
        'finalDate',
        'finalSlot',
        'finalLocation',
        'locations',
        'participants',
        'votes'
      ];

      return hasOnlyAllowedFields(allowedFields) &&
        hasRequiredFields(['id', 'title', 'hostNickname', 'maxParticipants', 'locations', 'participants', 'votes']) &&
        data.id == roomId &&
        validStringLength('id', 1, 64) &&
        validStringLength('title', 0, 200) &&
        validStringLength('hostNickname', 0, 100) &&
        data.maxParticipants is number &&
        data.maxParticipants >= 1 &&
        data.maxParticipants <= 20 &&
        (!('expiryDays' in data) || (data.expiryDays is number && data.expiryDays >= 1 && data.expiryDays <= 365)) &&
        isValidOptionalString('passcode', 0, 32) &&
        (!('passcodeUnlocked' in data) || data.passcodeUnlocked is bool) &&
        isValidOptionalString('storageMode', 0, 32) &&
        isValidOptionalString('hostUid', 0, 128) &&
        isValidOptionalString('hostEmail', 0, 254) &&
        isValidOptionalString('createdAt', 0, 64) &&
        (!('updatedAt' in data) || data.updatedAt is number || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
        (!('actorUpdatedAt' in data) || (data.actorUpdatedAt is map && data.actorUpdatedAt.size() <= 100)) &&
        (!('kickedIds' in data) || (data.kickedIds is map && data.kickedIds.size() <= 100)) &&
        (!('isFinalized' in data) || data.isFinalized is bool) &&
        isValidOptionalString('finalDate', 0, 32) &&
        isValidOptionalString('finalSlot', 0, 32) &&
        isValidOptionalString('finalLocation', 0, 200) &&
        isValidList(data.locations, 10) &&
        isValidList(data.participants, 50) &&
        isValidList(data.votes, 2000);
    }

    // ===============================================================
    // Collection Rules: /rooms/{roomId}
    // ===============================================================
    // Supports Squad Up's "No-registration Guest Hosting & Joining"
    // as well as Google Sign-In members. Both unauthenticated guests
    // and authenticated users can read, create, and update rooms.
    match /rooms/{roomId} {
      allow read: if true;

      allow create: if isValidRoom(request.resource.data, roomId);

      allow update: if isValidRoom(request.resource.data, roomId) &&
        request.resource.data.id == resource.data.id &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if isAuthenticated() &&
        'hostUid' in resource.data &&
        resource.data.hostUid != '' &&
        resource.data.hostUid == request.auth.uid;
    }

    // ===============================================================
    // Default Deny All Other Paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
